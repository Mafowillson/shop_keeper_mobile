  "privacyPolicyIntro": "ShopKeeper is committed to protecting your privacy. This policy explains what data we collect, how we use it, and your rights as a user.",
  "privacySec1Title": "Information We Collect",
  "privacySec1B1": "Account information: name, email address, and role (owner or staff).",
  "privacySec1B2": "Shop data: product catalogue, sales records, customer debts, and stock levels.",
  "privacySec1B3": "Device information: FCM token for push notifications.",
  "privacySec1B4": "Usage data: app activity logs for debugging and service improvement.",
  "privacySec2Title": "How We Use Your Data",
  "privacySec2B1": "To authenticate you and secure your account.",
  "privacySec2B2": "To sync your shop data across sessions and devices.",
  "privacySec2B3": "To send push notifications relevant to your business (stock alerts, sales, debts).",
  "privacySec2B4": "To generate AI-powered business insights on request.",
  "privacySec2B5": "To improve the app and fix issues.",
  "privacySec3Title": "Data Storage & Security",
  "privacySec3B1": "Your data is stored on secured servers with encrypted connections (HTTPS).",
  "privacySec3B2": "Passwords are hashed using bcrypt — we never store them in plain text.",
  "privacySec3B3": "Auth tokens are stored in encrypted secure storage on your device.",
  "privacySec3B4": "We do not sell your data to third parties.",
  "privacySec4Title": "Third-Party Services",
  "privacySec4B1": "Firebase Cloud Messaging (FCM) — for push notifications. Google Privacy Policy applies.",
  "privacySec4B2": "MongoDB Atlas — for cloud data storage. MongoDB Privacy Policy applies.",
  "privacySec4B3": "We do not use advertising networks or analytics platforms.",
  "privacySec5Title": "Your Rights",
  "privacySec5B1": "Access: you may request a copy of your stored data at any time.",
  "privacySec5B2": "Correction: you may update your account details in the app.",
  "privacySec5B3": "Deletion: you may request account and data deletion by contacting support.",
  "privacySec5B4": "Portability: your sales and inventory data can be exported on request.",
  "privacySec6Title": "Data Retention",
  "privacySec6B1": "Active account data is retained for as long as your account exists.",
  "privacySec6B2": "After account deletion, data is purged within 30 days.",
  "privacySec6B3": "Anonymised aggregate data may be retained for service analytics.",
  "privacySec7Title": "Contact",
  "privacySec7B1": "For privacy-related questions or requests, contact us at:",
  "privacySec7B2": "privacy@shopkeeper.cm",
  "privacySec7B3": "We respond within 5 business days.",

